rules_version = '2';

// Security rules for Volunteer Hub.
// Deploy with: firebase deploy --only firestore:rules
// (or paste into Firebase Console -> Firestore Database -> Rules)
//
// These rules are the real security boundary: anyone on the internet can call
// Firestore directly with the app's public config, so every check the UI does
// must be enforced again here.
service cloud.firestore {
  match /databases/{database}/documents {

    match /volunteer-events/{eventId} {

      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner() {
        return isSignedIn() && resource.data.createdBy == request.auth.uid;
      }

      function hasOnlyKnownKeys(data) {
        return data.keys().hasOnly([
          'title', 'organizer', 'date', 'location', 'description',
          'eventLink', 'maxVolunteers', 'volunteers', 'createdBy'
        ]);
      }

      function hasValidEventFields(data) {
        return data.title is string && data.title.size() > 0 && data.title.size() <= 100
          && data.organizer is string && data.organizer.size() > 0 && data.organizer.size() <= 100
          && data.location is string && data.location.size() > 0 && data.location.size() <= 200
          && data.description is string && data.description.size() > 0 && data.description.size() <= 1000
          && data.date is string && data.date.matches('\\d{4}-\\d{2}-\\d{2}')
          && data.maxVolunteers is int && data.maxVolunteers >= 1 && data.maxVolunteers <= 1000
          && data.eventLink is string && data.eventLink.size() <= 500
          && (data.eventLink == '' || data.eventLink.matches('https?://.*'))
          && data.volunteers is list;
      }

      // The only update a non-owner may make: append exactly their own uid to
      // the volunteers list, once, while the event still has room.
      function isSelfRegistration() {
        return isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['volunteers'])
          && !(request.auth.uid in resource.data.volunteers)
          && request.auth.uid in request.resource.data.volunteers
          && request.resource.data.volunteers.hasAll(resource.data.volunteers)
          && request.resource.data.volunteers.size() == resource.data.volunteers.size() + 1
          && request.resource.data.volunteers.size() <= resource.data.maxVolunteers;
      }

      // Events are a public listing: the app shows them without login.
      allow read: if true;

      // Only signed-in users can post, only as themselves, with a valid shape.
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.volunteers.size() == 0
        && hasOnlyKnownKeys(request.resource.data)
        && hasValidEventFields(request.resource.data);

      // Volunteers can register themselves; owners can edit their own event
      // (but never reassign ownership).
      allow update: if isSelfRegistration()
        || (isOwner()
            && request.resource.data.createdBy == resource.data.createdBy
            && hasOnlyKnownKeys(request.resource.data)
            && hasValidEventFields(request.resource.data));

      allow delete: if isOwner();
    }

    // Everything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
